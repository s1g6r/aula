# Copy to .env.local for development. Never commit real values.

# Postgres. Locally: Homebrew postgresql@17. In prod: Render sets this.
DATABASE_URL="postgresql://USER@localhost:5432/aula"

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL, used for join links and QR codes.
APP_URL="http://localhost:3000"

# LLM provider (OpenAI-compatible). We use Featherless.ai.
AI_BASE_URL="https://api.featherless.ai/v1"
AI_API_KEY=""
# Fast model for live captions (chosen by scripts/bench-models.ts, see docs/MODEL_BENCHMARK.md).
AI_MODEL_TRANSLATE="Qwen/Qwen3-30B-A3B-Instruct-2507"
# Stronger model for Somali, Haitian Creole and Dari, glossaries and recaps.
AI_MODEL_QUALITY="google/gemma-4-26B-A4B-it"
AI_MODEL_RECAP="Qwen/Qwen3-30B-A3B-Instruct-2507"

# Featherless plan concurrency units (Chat plan = 4) and each model's unit cost.
AI_CONCURRENCY_UNITS="4"
# Calls in flight at once. Featherless handled our parallel requests one
# after another, so 1 keeps our own priority order in charge.
AI_MAX_INFLIGHT="1"
AI_TRANSLATE_COST="1"
AI_QUALITY_COST="2"
AI_RECAP_COST="1"

# Translation pipeline tuning.
LESSON_CONCURRENCY="1"
AI_TIMEOUT_MS="8000"

# Privacy: auto-delete lesson data after N days; guest "Try it live" lessons after N hours.
DATA_RETENTION_DAYS="30"
GUEST_LESSON_TTL_HOURS="24"

# Demo teacher account created by `npm run db:seed`.
DEMO_TEACHER_EMAIL="demo@aulaapp.xyz"
DEMO_TEACHER_PASSWORD="aula-demo"

# Separate database for `npm test` DB tests. Must have "test" in its name.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/aula_test"
